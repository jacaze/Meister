# ===== Ambiente e Servidor =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_TIMEZONE=America/Sao_Paulo

# ===== Banco de Dados (PostgreSQL 16) =====
POSTGRES_USER=meister
POSTGRES_PASSWORD=meister_dev_password_change_me
POSTGRES_DB=meister
POSTGRES_PORT=5436
DATABASE_URL=postgresql://meister:meister_dev_password_change_me@localhost:5436/meister?schema=public
DIRECT_URL=postgresql://meister:meister_dev_password_change_me@localhost:5436/meister?schema=public

# ===== Autenticação e Segurança =====
# OBRIGATÓRIO: mínimo de 32 caracteres aleatórios. Gere com: openssl rand -base64 48
JWT_SECRET=substitua_por_uma_chave_aleatoria_com_pelo_menos_32_caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
LOCK_TIME_MINUTES=15
LOGIN_MAX_ATTEMPTS_PAIR=3
LOGIN_MAX_ATTEMPTS_ACCOUNT=10
LOGIN_MAX_ATTEMPTS_IP=30
REQUIRE_EMAIL_VERIFICATION=false

# ===== Fiscal MEI (Fallback se tabela fiscal_parameters estiver vazia) =====
MEI_ANNUAL_LIMIT=81000

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=meister_financas_bot
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# ===== Inteligência Artificial (Google Gemini) =====
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
NARRATION_MODE=auto

# ===== Open Finance (Pluggy / Meu Pluggy) =====
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# ===== E-mail Transacional =====
EMAIL_PROVIDER=console
EMAIL_FROM=nao-responda@meister.local
SMTP_HOST=localhost
SMTP_PORT=1025

# ===== Rotinas Internas e Demonstração =====
INTERNAL_TICK_SECRET=substitua_por_segredo_tick_interno_32_chars
DEMO_MODE=true
