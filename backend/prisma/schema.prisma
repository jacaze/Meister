generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  mei
  pessoa_fisica
}

enum TransactionType {
  receita
  despesa
}

enum PaymentMethod {
  dinheiro
  pix
  cartao_credito
  cartao_debito
  boleto
  outro
}

enum TransactionOrigin {
  manual
  telegram
  open_finance
  importacao
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  passwordHash   String      @map("password_hash")
  accountType    AccountType @default(pessoa_fisica) @map("account_type")
  failedAttempts Int         @default(0) @map("failed_attempts")
  lockUntil      DateTime?   @map("lock_until")
  timezone       String      @default("America/Sao_Paulo")
  status         String      @default("ativo")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  deletedAt      DateTime?   @map("deleted_at")

  memberships    WorkspaceMember[]
  sessions       Session[]
  emailTokens    EmailToken[]
  categories     Category[]
  transactions   Transaction[]
  telegramLinks  TelegramLink[]
  linkTokens     TelegramLinkToken[]
  proposals      Proposal[]
  insights       Insight[]
  insightFeedbacks InsightFeedback[]
  insightPreferences InsightPreference[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  familyId    String    @map("family_id")
  refreshHash String    @map("refresh_hash")
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at")
  rotatedAt   DateTime? @map("rotated_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("sessions")
}

model EmailToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String    // verify | reset
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at")

  members              WorkspaceMember[]
  entities             Entity[]
  categories           Category[]
  transactions         Transaction[]
  financialAccounts    FinancialAccount[]
  categorizationRules  CategorizationRule[]
  jarPlans             JarPlan[]
  dasCharges           DasCharge[]
  fiscalReceipts       FiscalReceipt[]
  telegramLinks        TelegramLink[]
  proposals            Proposal[]
  transactionAudits    TransactionAudit[]
  insights             Insight[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("owner") // owner | editor | viewer
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model Entity {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  kind        String    // pf | pj
  name        String
  cnpj        String?   @unique
  legalName   String?   @map("legal_name")
  openedOn    DateTime? @map("opened_on") @db.Date
  activity    String?   // comercio | servicos | misto
  isMei       Boolean   @default(false) @map("is_mei")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  financialAccounts FinancialAccount[]
  dasCharges        DasCharge[]
  limitAlerts       LimitAlert[]
  jarPlans          JarPlan[]
  insights          Insight[]

  @@index([workspaceId, active])
  @@map("entities")
}

model Category {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  userId      String?         @map("user_id")
  slug        String
  name        String
  type        TransactionType
  isDefault   Boolean         @default(false) @map("is_default")
  archivedAt  DateTime?       @map("archived_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions        Transaction[]
  splits              TransactionSplit[]
  categorizationRules CategorizationRule[]
  jarCategories       JarCategory[]

  @@unique([workspaceId, type, slug])
  @@index([workspaceId, type])
  @@map("categories")
}

model FinancialAccount {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  entityId       String   @map("entity_id")
  kind           String   // caixa | banco | cartao
  name           String
  institution    String?
  source         String   @default("manual") // manual | pluggy
  externalId     String?  @map("external_id")
  openingBalance Decimal  @default(0.00) @map("opening_balance") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity       Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, entityId])
  @@map("financial_accounts")
}

model CategorizationRule {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  entityId    String?  @map("entity_id")
  pattern     String
  categoryId  String   @map("category_id")
  hits        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, pattern])
  @@map("categorization_rules")
}

model Transaction {
  id                 String             @id @default(uuid())
  workspaceId        String             @map("workspace_id")
  entityId           String             @map("entity_id")
  userId             String?            @map("user_id")
  financialAccountId String?            @map("financial_account_id")
  categoryId         String?            @map("category_id")
  type               TransactionType
  direction          String?            // in | out
  description        String
  amount             Decimal            @db.Decimal(14, 2)
  paymentMethod      PaymentMethod?     @map("payment_method")
  transactionDate    DateTime           @map("transaction_date") @db.Date
  origin             TransactionOrigin  @default(manual)
  status             String             @default("confirmado") // confirmado | pendente_revisao
  externalProvider   String?            @map("external_provider")
  externalId         String?            @map("external_id")
  transferGroupId    String?            @map("transfer_group_id")
  counterparty       String?
  notes              String?
  sourceRef          String?            @map("source_ref")
  viaPersonalAccount Boolean            @default(false) @map("via_personal_account")
  aiConfidence       Decimal?           @map("ai_confidence") @db.Decimal(5, 4)
  createdBy          String?            @map("created_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity           Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  financialAccount FinancialAccount?  @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  splits           TransactionSplit[]
  audits           TransactionAudit[]

  @@unique([externalProvider, externalId])
  @@unique([workspaceId, sourceRef])
  @@index([workspaceId, transactionDate])
  @@index([workspaceId, entityId, type, transactionDate])
  @@map("transactions")
}

model TransactionSplit {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  categoryId    String  @map("category_id")
  amount        Decimal @db.Decimal(14, 2)
  description   String?
  position      Int     @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_splits")
}

model TransactionAudit {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  transactionId String   @map("transaction_id")
  actor         String
  action        String   // create | update | delete
  before        Json?
  after         Json?
  at            DateTime @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, transactionId])
  @@map("transaction_audit")
}

model FiscalParameters {
  year                Int     @id
  meiAnnualLimit      Decimal @map("mei_annual_limit") @db.Decimal(14, 2)
  meiMonthlyReference Decimal @map("mei_monthly_reference") @db.Decimal(14, 2)
  tolerancePct        Decimal @map("tolerance_pct") @db.Decimal(5, 4)
  minimumWage         Decimal @map("minimum_wage") @db.Decimal(14, 2)
  icmsAmount          Decimal @map("icms_amount") @db.Decimal(14, 2)
  issAmount           Decimal @map("iss_amount") @db.Decimal(14, 2)
  inssPct             Decimal @map("inss_pct") @db.Decimal(5, 4)

  @@map("fiscal_parameters")
}

model DasCharge {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  entityId    String    @map("entity_id")
  competence  String    // YYYY-MM
  dueDate     DateTime  @map("due_date") @db.Date
  amount      Decimal   @db.Decimal(14, 2)
  status      String    @default("pendente") // pendente | pago | atrasado
  paidOn      DateTime? @map("paid_on") @db.Date
  paidAmount  Decimal?  @map("paid_amount") @db.Decimal(14, 2)
  source      String    @default("manual") // manual | open_finance
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity    Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, competence])
  @@index([workspaceId, status])
  @@map("das_charges")
}

model LimitAlert {
  id       String   @id @default(uuid())
  entityId String   @map("entity_id")
  year     Int
  band     String   // atencao | excedido | desenquadramento
  sentAt   DateTime @default(now()) @map("sent_at")

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, year, band])
  @@map("limit_alerts")
}

model JarPlan {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  entityId    String   @map("entity_id")
  name        String
  template    String   // mei-empresa | seis-potes | 50-30-20 | personalizado
  baseMode    String   @default("mes_atual") @map("base_mode") // mes_atual | mes_anterior | media_3_meses
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity     Entity               @relation(fields: [entityId], references: [id], onDelete: Cascade)
  jars       Jar[]
  categories JarCategory[]
  snapshots  JarPeriodSnapshot[]

  @@index([workspaceId, entityId, active])
  @@map("jar_plans")
}

model Jar {
  id          String    @id @default(uuid())
  planId      String    @map("plan_id")
  slug        String
  name        String
  percent     Decimal?  @db.Decimal(5, 2)
  fixedAmount Decimal?  @map("fixed_amount") @db.Decimal(14, 2)
  rollover    Boolean   @default(false)
  goalAmount  Decimal?  @map("goal_amount") @db.Decimal(14, 2)
  goalDate    DateTime? @map("goal_date") @db.Date
  sort        Int       @default(0)

  plan       JarPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  categories JarCategory[]
  snapshots  JarPeriodSnapshot[]
  alerts     JarAlert[]

  @@unique([planId, slug])
  @@map("jars")
}

model JarCategory {
  planId     String @map("plan_id")
  categoryId String @map("category_id")
  jarId      String @map("jar_id")

  plan     JarPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jar      Jar      @relation(fields: [jarId], references: [id], onDelete: Cascade)

  @@id([planId, categoryId])
  @@map("jar_categories")
}

model JarPeriodSnapshot {
  planId      String   @map("plan_id")
  jarId       String   @map("jar_id")
  period      String   // YYYY-MM
  allocated   Decimal  @db.Decimal(14, 2)
  used        Decimal  @db.Decimal(14, 2)
  carriedOver Decimal  @default(0.00) @map("carried_over") @db.Decimal(14, 2)
  closedAt    DateTime @default(now()) @map("closed_at")

  plan JarPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  jar  Jar     @relation(fields: [jarId], references: [id], onDelete: Cascade)

  @@id([jarId, period])
  @@map("jar_period_snapshots")
}

model JarAlert {
  id     String   @id @default(uuid())
  jarId  String   @map("jar_id")
  period String   // YYYY-MM
  band   String   // atencao | estourado
  sentAt DateTime @default(now()) @map("sent_at")

  jar Jar @relation(fields: [jarId], references: [id], onDelete: Cascade)

  @@unique([jarId, period, band])
  @@map("jar_alerts")
}

model FiscalReceipt {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  accessKey   String    @map("access_key") @db.Char(44)
  issuerCnpj  String?   @map("issuer_cnpj")
  issuedOn    DateTime? @map("issued_on") @db.Date
  total       Decimal?  @db.Decimal(14, 2)
  source      String    @default("ia") // sefaz | ia | qr_offline
  items       Json?
  discount    Decimal?  @db.Decimal(14, 2)
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, accessKey])
  @@map("fiscal_receipts")
}

model TelegramLink {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  workspaceId    String    @map("workspace_id")
  chatId         String    @unique @map("chat_id")
  telegramUserId String?   @map("telegram_user_id")
  status         String    @default("ativo") // ativo | revogado | bloqueado_pelo_usuario
  linkedAt       DateTime  @default(now()) @map("linked_at")
  revokedAt      DateTime? @map("revoked_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("telegram_links")
}

model TelegramLinkToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_tokens")
}

model InboundUpdate {
  id          String    @id @default(uuid())
  updateId    BigInt    @unique @map("update_id")
  chatId      String    @map("chat_id")
  kind        String    // text | photo | voice | callback | command
  status      String    @default("recebida") // recebida | processando | processada | erro | ignorada
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([chatId, status])
  @@map("inbound_updates")
}

model Proposal {
  id                     String    @id @default(uuid())
  workspaceId            String    @map("workspace_id")
  userId                 String    @map("user_id")
  draft                  Json
  confidence             Decimal   @db.Decimal(5, 4)
  ambiguous              Json?
  pendingQuestion        Json?     @map("pending_question")
  status                 String    @default("aberta") // aberta | confirmada | cancelada | expirada
  source                 String    @default("texto") // texto | foto | nfce | audio | web
  sourceRef              String?   @map("source_ref")
  expiresAt              DateTime  @map("expires_at")
  confirmedTransactionId String?   @map("confirmed_transaction_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, status])
  @@map("proposals")
}

model AiRun {
  id            String   @id @default(uuid())
  proposalId    String?  @map("proposal_id")
  kind          String   // text | audio | image
  model         String
  promptVersion String   @map("prompt_version")
  inputHash     String   @map("input_hash")
  output        Json
  tokensIn      Int?     @map("tokens_in")
  tokensOut     Int?     @map("tokens_out")
  latencyMs     Int      @map("latency_ms")
  outcome       String   @default("success") // success | rejected | error
  errorCode     String?  @map("error_code")
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([inputHash])
  @@map("ai_runs")
}

model Insight {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  userId          String?   @map("user_id")
  entityId        String?   @map("entity_id")
  detectorId      String    @map("detector_id")
  detectorVersion String    @default("1.0") @map("detector_version")
  period          String    // e.g. "2026-11"
  severity        String    // info | atencao | alerta
  confidence      String    @default("alta") // alta | estimativa
  metrics         Json
  actions         Json?
  narrationText   String    @map("narration_text")
  narrationSource String    @default("template") @map("narration_source") // template | llm
  templateId      String?   @map("template_id")
  promptVersion   String?   @map("prompt_version")
  dedupeKey       String    @unique @map("dedupe_key")
  status          String    @default("nova") // nova | vista | dispensada | acao_tomada | expirada
  createdAt       DateTime  @default(now()) @map("created_at")
  seenAt          DateTime? @map("seen_at")
  expiresAt       DateTime? @map("expires_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    Entity?   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  feedbacks InsightFeedback[]

  @@index([workspaceId, entityId, status])
  @@index([workspaceId, createdAt])
  @@map("insights")
}

model InsightFeedback {
  id        String   @id @default(uuid())
  insightId String   @map("insight_id")
  userId    String   @map("user_id")
  value     String   // util | inutil
  reason    String?  // nao_e_util | errado | repetitivo | outro
  createdAt DateTime @default(now()) @map("created_at")

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([insightId])
  @@map("insight_feedbacks")
}

model InsightPreference {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  detectorId   String?   @map("detector_id")
  enabled      Boolean   @default(true)
  sensitivity  String    @default("normal") // baixa | normal | alta
  aiNarration  Boolean   @default(false) @map("ai_narration")
  snoozedUntil DateTime? @map("snoozed_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, detectorId])
  @@map("insight_preferences")
}
